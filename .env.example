# Rahim Cinema – Beispielkonfiguration. Kopieren nach ".env" und ausfüllen.
# Die Datei ".env" wird NIE eingecheckt (steht in .gitignore).

# --- TMDB (optional, für den grossen Film- und Serienkatalog) ---
# Eines von beiden genügt. Erhältlich unter https://www.themoviedb.org/settings/api
# Empfohlen: "API Read Access Token" (langer Text, beginnt meist mit "eyJ")
TMDB_READ_ACCESS_TOKEN=
# Alternativ: "API Key" (32 Zeichen, v3)
TMDB_API_KEY=

# --- Allgemein ---
PORT=8787
# Kontaktadresse für den User-Agent (Wikimedia verlangt einen identifizierbaren User-Agent)
CONTACT=kontakt@example.org
# Öffentliche Adresse der Seite (nur für den User-Agent / Hinweise)
PUBLIC_URL=http://localhost:8787

# --- Datenquellen (Standardwerte funktionieren ohne Änderung) ---
IPTV_API_BASE=https://iptv-org.github.io/api
# Internet-Archive-Sammlungen, aus denen Filme mit Lizenzangabe gelesen werden
IA_COLLECTIONS=feature_films,prelinger
# Kommagetrennte Liste, um einzelne Adapter abzuschalten: tmdb,tvmaze,wikidata,archive,iptv
DISABLED_SOURCES=

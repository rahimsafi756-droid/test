{
  "name": "rahim-cinema",
  "version": "0.1.0",
  "private": true,
  "description": "Rahim Cinema – Filme, Serien und Live-TV aus geprüften Quellen",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/dev.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "snapshot:iptv": "tsx scripts/build-iptv-snapshot.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hls.js": "^1.7.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
